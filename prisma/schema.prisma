// TDMS — Prisma schema.
//
// Mapped 1:1 onto the tables the Laravel migrations already created in
// PostgreSQL. Every @@map/@map exists so that not one column or table is
// renamed: the live database is reused as-is and no data is moved.
//
// Laravel conventions preserved deliberately:
//   * snake_case columns        -> @map on each field
//   * plural snake_case tables  -> @@map on each model
//   * BigInt auto-increment ids -> BigInt @id @default(autoincrement())
//   * Laravel enum() columns    -> Prisma enums whose member names are the
//                                  exact strings already stored as text
//   * created_at / updated_at   -> @map("created_at") / @map("updated_at")
//
// Prisma has no equivalent of Eloquent's polymorphic `model_type` string, so
// Spatie's model_has_roles / model_has_permissions keep their literal shape
// and are queried with model_type = 'App\Models\User' (see
// src/server/auth/rbac.ts). Existing rows therefore stay valid untouched.

generator client {
  provider = "prisma-client-js"
  // native: this machine. rhel-openssl-3.0.x: Vercel's build and function runtime (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / accounts
// ---------------------------------------------------------------------------

model User {
  id                 BigInt    @id @default(autoincrement())
  name               String    @db.VarChar(255)
  /// Added by the migration that finally makes the "Username or Email"
  /// login label true. Nullable: accounts created from the Staff screen
  /// still sign in with their email only.
  username           String?   @unique(map: "users_username_unique") @db.VarChar(255)
  email              String    @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamp(0)
  /// bcrypt hash written by PHP ($2y$12$...). bcryptjs verifies these
  /// unchanged, so no existing account needs a password reset.
  password           String    @db.VarChar(255)
  /// True while the password on this row is a temporary one issued by a
  /// Super Admin. It is a technical fact about the credential, NOT an
  /// account state: the account is ACTIVE and `status` is not misused to
  /// record setup progress. requireUser()/requireApiUser() divert the holder
  /// to the change-password screen until it is cleared.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// When the account holder last chose their own password: replacing a
  /// temporary one, changing it from the profile, or completing an emailed
  /// reset. NULL for an account still on the password it was issued. A
  /// password set BY a Super Admin (create, reset) does not touch it — that
  /// is not the holder's choice, and `mustChangePassword` already says so.
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamp(0)
  rememberToken      String?   @map("remember_token") @db.VarChar(100)
  /// Google's stable subject identifier (`sub`). The join key for Google
  /// sign-in: an address can change, `sub` does not. Unique, so one Google
  /// account cannot end up attached to two TDMS accounts.
  googleId           String?   @unique(map: "users_google_id_unique") @map("google_id") @db.VarChar(255)
  firstName          String?   @map("first_name") @db.VarChar(255)
  lastName           String?   @map("last_name") @db.VarChar(255)
  avatarUrl          String?   @map("avatar_url")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamp(0)
  /// Authoritative account state: PENDING | ACTIVE | INACTIVE | SUSPENDED.
  /// Only ACTIVE, with emailVerifiedAt set, may authenticate. Google proving
  /// who somebody is does not by itself make their account ACTIVE.
  /// varchar rather than a Prisma enum for the same reason as every other
  /// status column here — see the note at the foot of this file.
  status             String    @default("PENDING") @db.VarChar(32)
  /// Superseded by `status`, retained so no migration has to drop a column
  /// on a live database. Nothing reads it; account-mutating code keeps it in
  /// step (is_active = status === 'ACTIVE') so the two can never disagree.
  /// Safe to drop once you are happy to.
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)

  /// Eloquent declared hasOne(Student), but students.user_id carries no
  /// unique index in the live database, so a one-to-one here would demand
  /// a schema change. Modelled as a list and narrowed to the first row in
  /// the service layer — exactly what Eloquent's hasOne does at runtime.
  students                   Student[]                 @relation("StudentAccount")
  sessions                   Session[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetRequests      PasswordResetRequest[]
  reviewedApplications       Application[]             @relation("ApplicationReviewer")
  submittedCredentials       StudentCredential[]       @relation("CredentialSubmitter")
  verifiedCredentials        StudentCredential[]       @relation("CredentialVerifier")
  approvedEnrollments        Enrollment[]              @relation("EnrollmentApprover")
  enrollmentChanges          EnrollmentStatusHistory[] @relation("EnrollmentStatusActor")
  accessCodes                AdminAccessCode[]         @relation("AdminAccessCodeSubject")
  issuedAccessCodes          AdminAccessCode[]         @relation("AdminAccessCodeIssuer")
  revokedAccessCodes         AdminAccessCode[]         @relation("AdminAccessCodeRevoker")
  temporaryCredentials       TemporaryCredential[]     @relation("TemporaryCredentialOwner")
  issuedTemporaryCredentials TemporaryCredential[]     @relation("TemporaryCredentialIssuer")
  loginChallenges            AdminLoginChallenge[]
  /// Classes this account teaches, as a Diploma Instructor.
  taughtClasses              ClassOffering[]           @relation("ClassInstructor")
  notifications              Notification[]
  instructorProfile          InstructorProfile?

  @@map("users")
}

/// Replaces the payload of Laravel's `sessions` table, which is a
/// PHP-serialised blob Node cannot read. A separate table, so the old rows
/// are left untouched rather than deleted — nothing reads them any more.
model Session {
  id             String   @id @db.VarChar(128)
  userId         BigInt   @map("user_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt      DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Single-use, expiring email verification tokens.
///
/// Only the SHA-256 of the token is stored, exactly as for session tokens: a
/// database dump must not yield a working verification link. The plaintext
/// exists only in the email that was sent.
model EmailVerificationToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique(map: "email_verification_tokens_token_hash_unique") @map("token_hash") @db.VarChar(64)
  /// The address the token was issued for. If the user changes their email
  /// before clicking, the token no longer matches and is refused.
  email      String    @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use, expiring password reset tokens. Same storage rules as above.
///
/// Replaces Laravel's `password_reset_tokens`, which held one plaintext token
/// per email address with no expiry column; that table is left untouched.
model PasswordResetRequest {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique(map: "password_reset_requests_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_requests")
}

/// Whether this installation has been through first-run setup.
///
/// At most one row (id is pinned to 1 by a CHECK constraint in the
/// migration). Its absence means UNINITIALIZED; its presence means
/// INITIALIZED. First-run setup inserts it in the same transaction that
/// creates the first Super Admin, so the primary key is what stops two
/// concurrent setups from both succeeding — the second insert fails.
///
/// Only `npm run db:fresh` removes it. Deleting users alone does not reopen
/// /setup.
model SystemInstallation {
  id            Int      @id @default(1) @db.SmallInt
  initializedAt DateTime @map("initialized_at") @db.Timestamp(0)
  /// "setup" (the /setup page), "cli" (npm run admin:create) or
  /// "pre-existing" (backfilled for a database that already had accounts).
  method        String   @db.VarChar(32)

  @@map("system_installation")
}

/// A Super Admin registration that has been filled in but NOT yet verified.
///
/// This table is the reason no `users` row exists before the institutional
/// address is proven. The setup form writes here, the emailed code is checked
/// against here, and only then is a real account created — inside one
/// transaction that also deletes the row it came from.
///
/// What is stored, and what is deliberately not:
///   * `passwordHash` is a finished bcrypt hash. The plaintext password is
///     never stored, never emailed and never logged, exactly as for a live
///     account. A pending row is not a weaker place to keep a password.
///   * `verificationCodeHash` is bcrypt, not SHA-256, because a six-digit
///     code has too little entropy for a fast digest to protect — see
///     src/server/auth/verification-code.ts.
///   * `handleHash` is the SHA-256 of the opaque handle in the browser's
///     HttpOnly cookie. It is what ties a verification attempt to this row,
///     so attempts cannot be aimed at somebody else's pending registration.
///   * `verificationAttempts` and `resendCount` are the per-registration
///     brakes; IP-level throttling lives in the cache table alongside the
///     login throttle.
///
/// Nothing here grants access. A pending row cannot sign in, holds no
/// session, and has no role.
model PendingAdminRegistration {
  id                    BigInt    @id @default(autoincrement())
  fullName              String    @map("full_name") @db.VarChar(255)
  /// One pending registration per address, enforced by the database rather
  /// than by a read-then-write that two requests could interleave.
  email                 String    @unique(map: "pending_admin_registrations_email_unique") @db.VarChar(255)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  /// Emptied the moment the code is accepted, so a code is strictly single use.
  verificationCodeHash  String    @map("verification_code_hash") @db.VarChar(255)
  verificationExpiresAt DateTime  @map("verification_expires_at")
  verificationAttempts  Int       @default(0) @map("verification_attempts")
  resendCount           Int       @default(0) @map("resend_count")
  /// When the current code was sent. Drives the resend cooldown.
  lastSentAt            DateTime  @default(now()) @map("last_sent_at")
  handleHash            String    @unique(map: "pending_admin_registrations_handle_hash_unique") @map("handle_hash") @db.VarChar(64)
  /// Set only by a correct code. Until it is non-null, no account may be
  /// created from this row under any circumstances.
  verifiedAt            DateTime? @map("verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([verificationExpiresAt])
  @@map("pending_admin_registrations")
}

/// A one-time access code issued by a Super Admin for ONE Admin account.
///
/// This is the second factor on an Admin sign-in: the password proves the
/// credential, this proves the Super Admin actually meant to let that person
/// in today. The two are deliberately issued by different people.
///
/// What is stored, and why:
///   * `codeHash` is bcrypt, not SHA-256. Six digits is under 20 bits of
///     entropy, and a plain digest of that could be reversed from a database
///     dump by hashing a million candidates in under a second. See
///     src/server/auth/admin-access-code.ts for the full reasoning — it is
///     the same as for the Super Admin setup code.
///   * `usedAt` is what makes the code single use. It is stamped inside the
///     same transaction that creates the session, so two requests racing on
///     one code cannot both win.
///   * `revokedAt` is a different fact from `usedAt`: the code was withdrawn
///     before anyone used it — by a Super Admin, by a newer code superseding
///     it, by too many wrong guesses, or by the account being suspended or
///     its password reset. `revokedReason` says which and `revokedBy` who, so
///     the dashboard and the audit trail can tell them apart.
///   * `attemptCount` / `maxAttempts` are the per-code guess budget. At this
///     entropy the attempt cap, not the length, is what protects the code.
///
/// The plaintext code exists in exactly two places and neither is durable:
/// the response that shows it to the Super Admin once, and (optionally) the
/// email to the Admin. It is never persisted, never logged and never
/// returned again.
model AdminAccessCode {
  id            BigInt    @id @default(autoincrement())
  /// The Admin this code admits. A code is useless against any other row.
  adminUserId   BigInt    @map("admin_user_id")
  codeHash      String    @map("code_hash") @db.VarChar(255)
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  revokedAt     DateTime? @map("revoked_at")
  /// revoked | superseded | attempts_exhausted | account_suspended | password_reset
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  /// The Super Admin who revoked it by hand. Null for automatic revocations.
  revokedBy     BigInt?   @map("revoked_by")
  attemptCount  Int       @default(0) @map("attempt_count")
  /// Copied from configuration at issue time, so changing the limit later
  /// cannot retroactively revive a code that was already burnt.
  maxAttempts   Int       @map("max_attempts")
  /// The Super Admin who issued it. Nullable only so deleting that account
  /// does not delete the audit trail of what they issued.
  createdBy     BigInt?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  admin   User  @relation("AdminAccessCodeSubject", fields: [adminUserId], references: [id], onDelete: Cascade)
  issuer  User? @relation("AdminAccessCodeIssuer", fields: [createdBy], references: [id], onDelete: SetNull)
  revoker User? @relation("AdminAccessCodeRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_access_codes")
}

/// A temporary password, sealed so a Super Admin can reveal it again until the
/// Admin replaces it.
///
/// NOT the credential the login checks — that is still the bcrypt hash on
/// users.password. This is an AES-256-GCM ciphertext under TEMP_CREDENTIAL_KEY,
/// a key the database never holds, bound to this user id. See
/// src/server/auth/credential-vault.ts.
///
/// `sealed` is emptied the moment the credential stops being revealable: the
/// Admin chose their own password (usedAt), a Super Admin reissued one
/// (revokedAt), or the reveal window passed (expiresAt). A permanent password is
/// never stored here or anywhere else in a recoverable form.
model TemporaryCredential {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  sealed        String
  createdBy     BigInt?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// End of the reveal window. The password itself keeps working after it.
  expiresAt     DateTime  @map("expires_at")
  /// The Admin replaced it with their own password.
  usedAt        DateTime? @map("used_at")
  /// Superseded by a reset.
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)

  user    User  @relation("TemporaryCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("TemporaryCredentialIssuer", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("temporary_credentials")
}

/// One Admin sign-in that has passed the password but not yet the code.
///
/// This row is the reason no session exists between the two steps. The
/// alternative — issuing a session and marking it "not yet allowed in" —
/// puts a credential in the browser that grants nothing, which is exactly
/// the shape that produced the /login redirect loop this codebase already
/// fixed once (see src/middleware.ts). A half-finished sign-in is therefore
/// its own object, and it holds no session and no role.
///
/// The browser is identified by an opaque handle in an HttpOnly cookie, of
/// which only the SHA-256 is stored — the same scheme as session tokens and
/// the Super Admin setup handle. Identifying the row this way rather than by
/// trusting a user id in the request body is what stops code attempts being
/// aimed at somebody else's half-finished sign-in.
model AdminLoginChallenge {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  handleHash String    @unique(map: "admin_login_challenges_handle_hash_unique") @map("handle_hash") @db.VarChar(64)
  /// Carried from step 1, because the session is created at step 2 and the
  /// "Remember me" tick would otherwise be lost between them.
  remember   Boolean   @default(false)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  /// Stamped when the challenge is exchanged for a session, so one password
  /// step cannot be replayed into two sessions.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_login_challenges")
}

model PasswordResetToken {
  email     String    @id @db.VarChar(255)
  token     String    @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Spatie laravel-permission tables, reused verbatim
// ---------------------------------------------------------------------------

model Role {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  guardName String    @map("guard_name") @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  permissions RoleHasPermission[]
  models      ModelHasRole[]

  @@unique([name, guardName], map: "roles_name_guard_name_unique")
  @@map("roles")
}

model Permission {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  guardName String    @map("guard_name") @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  roles  RoleHasPermission[]
  models ModelHasPermission[]

  @@unique([name, guardName], map: "permissions_name_guard_name_unique")
  @@map("permissions")
}

model RoleHasPermission {
  permissionId BigInt @map("permission_id")
  roleId       BigInt @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "role_has_permissions_permission_id_foreign", onUpdate: NoAction)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_has_permissions_role_id_foreign", onUpdate: NoAction)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

model ModelHasRole {
  roleId    BigInt @map("role_id")
  modelType String @map("model_type") @db.VarChar(255)
  modelId   BigInt @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "model_has_roles_role_id_foreign", onUpdate: NoAction)

  @@id([roleId, modelId, modelType])
  @@index([modelId, modelType], map: "model_has_roles_model_id_model_type_index")
  @@map("model_has_roles")
}

model ModelHasPermission {
  permissionId BigInt @map("permission_id")
  modelType    String @map("model_type") @db.VarChar(255)
  modelId      BigInt @map("model_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "model_has_permissions_permission_id_foreign", onUpdate: NoAction)

  @@id([permissionId, modelId, modelType])
  @@index([modelId, modelType], map: "model_has_permissions_model_id_model_type_index")
  @@map("model_has_permissions")
}

// ---------------------------------------------------------------------------
// Academic domain
// ---------------------------------------------------------------------------

model Program {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique(map: "programs_code_unique") @db.VarChar(255)
  name        String    @db.VarChar(255)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  curricula              Curriculum[]
  students               Student[]
  applications           Application[]
  credentialRequirements CredentialRequirement[]
  sections               Section[]

  @@map("programs")
}

model Curriculum {
  id                  BigInt    @id @default(autoincrement())
  programId           BigInt    @map("program_id")
  versionLabel        String    @map("version_label") @db.VarChar(255)
  effectiveSchoolYear String    @map("effective_school_year") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(0)

  // Laravel restrictOnDelete() -> onDelete: Restrict
  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict, map: "curricula_program_id_foreign", onUpdate: NoAction)
  curriculumSubjects CurriculumSubject[]
  students           Student[]
  enrollments        Enrollment[]

  @@unique([programId, versionLabel], map: "curricula_program_id_version_label_unique")
  @@map("curricula")
}

model Subject {
  id           BigInt    @id @default(autoincrement())
  code         String    @unique(map: "subjects_code_unique") @db.VarChar(255)
  title        String    @db.VarChar(255)
  description  String?
  subjectType  String    @map("subject_type") @db.VarChar(255)
  defaultUnits Decimal   @map("default_units") @db.Decimal(4, 1)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  curriculumSubjects CurriculumSubject[] @relation("CurriculumSubjectSubject")
  prerequisiteFor    CurriculumSubject[] @relation("CurriculumSubjectPrerequisite")
  classes            ClassOffering[]

  @@map("subjects")
}

model CurriculumSubject {
  id                    BigInt    @id @default(autoincrement())
  curriculumId          BigInt    @map("curriculum_id")
  subjectId             BigInt    @map("subject_id")
  prerequisiteSubjectId BigInt?   @map("prerequisite_subject_id")
  yearLevel             Int       @map("year_level") @db.SmallInt
  semester              Int       @db.SmallInt
  units                 Decimal   @db.Decimal(4, 1)
  createdAt             DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime? @map("updated_at") @db.Timestamp(0)

  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade, map: "curriculum_subjects_curriculum_id_foreign", onUpdate: NoAction)
  subject      Subject    @relation("CurriculumSubjectSubject", fields: [subjectId], references: [id], onDelete: Restrict, map: "curriculum_subjects_subject_id_foreign", onUpdate: NoAction)
  prerequisite Subject?   @relation("CurriculumSubjectPrerequisite", fields: [prerequisiteSubjectId], references: [id], onDelete: SetNull, map: "curriculum_subjects_prerequisite_subject_id_foreign", onUpdate: NoAction)

  @@unique([curriculumId, subjectId], map: "curriculum_subjects_curriculum_id_subject_id_unique")
  @@map("curriculum_subjects")
}

model Student {
  id             BigInt    @id @default(autoincrement())
  userId         BigInt?   @map("user_id")
  studentNumber  String    @unique(map: "students_student_number_unique") @map("student_number") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(255)
  middleName     String?   @map("middle_name") @db.VarChar(255)
  lastName       String    @map("last_name") @db.VarChar(255)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(255)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  programId      BigInt    @map("program_id")
  curriculumId   BigInt    @map("curriculum_id")
  yearLevel      Int       @default(1) @map("year_level") @db.SmallInt
  status         String    @default("active") @db.VarChar(255)
  enrollmentDate DateTime? @map("enrollment_date") @db.Date
  /// The opaque value printed in the student's attendance QR code. Random,
  /// not derived from the student number, so a QR cannot be forged from an
  /// ID card someone has seen. Issued lazily for records created before it.
  qrToken        String?   @unique(map: "students_qr_token_unique") @map("qr_token") @db.VarChar(64)
  createdAt      DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(0)

  user        User?               @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull, map: "students_user_id_foreign", onUpdate: NoAction)
  program     Program             @relation(fields: [programId], references: [id], onDelete: Restrict, map: "students_program_id_foreign", onUpdate: NoAction)
  curriculum  Curriculum          @relation(fields: [curriculumId], references: [id], onDelete: Restrict, map: "students_curriculum_id_foreign", onUpdate: NoAction)
  application Application[]
  credentials StudentCredential[]
  enrollments Enrollment[]

  sectionMemberships SectionStudent[]
  attendance         AttendanceRecord[]
  scores             AssessmentScore[]
  grades             ClassGrade[]
  badges             StudentBadge[]
  statusRequests     StudentStatusRequest[]
  learningSupports   LearningSupport[]

  @@map("students")
}

model Application {
  id          BigInt    @id @default(autoincrement())
  firstName   String    @map("first_name") @db.VarChar(255)
  middleName  String?   @map("middle_name") @db.VarChar(255)
  lastName    String    @map("last_name") @db.VarChar(255)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(255)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  programId   BigInt    @map("program_id")
  status      String    @default("submitted") @db.VarChar(255)
  notes       String?
  reviewedBy  BigInt?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamp(0)
  studentId   BigInt?   @map("student_id")
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  program  Program  @relation(fields: [programId], references: [id], onDelete: Restrict, map: "applications_program_id_foreign", onUpdate: NoAction)
  reviewer User?    @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, map: "applications_reviewed_by_foreign", onUpdate: NoAction)
  student  Student? @relation(fields: [studentId], references: [id], onDelete: SetNull, map: "applications_student_id_foreign", onUpdate: NoAction)

  @@map("applications")
}

model CredentialRequirement {
  id         BigInt    @id @default(autoincrement())
  programId  BigInt?   @map("program_id")
  name       String    @db.VarChar(255)
  isRequired Boolean   @default(true) @map("is_required")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  program            Program?            @relation(fields: [programId], references: [id], onDelete: Restrict, map: "credential_requirements_program_id_foreign", onUpdate: NoAction)
  studentCredentials StudentCredential[]

  @@map("credential_requirements")
}

model StudentCredential {
  id                      BigInt    @id @default(autoincrement())
  studentId               BigInt    @map("student_id")
  credentialRequirementId BigInt    @map("credential_requirement_id")
  filePath                String?   @map("file_path") @db.VarChar(255)
  submittedBy             BigInt?   @map("submitted_by")
  submittedAt             DateTime? @map("submitted_at") @db.Timestamp(0)
  status                  String    @default("missing") @db.VarChar(255)
  verifiedBy              BigInt?   @map("verified_by")
  verifiedAt              DateTime? @map("verified_at") @db.Timestamp(0)
  remarks                 String?
  rejectionReason         String?   @map("rejection_reason")
  version                 Int       @default(1)
  createdAt               DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt               DateTime? @map("updated_at") @db.Timestamp(0)

  student     Student               @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "student_credentials_student_id_foreign", onUpdate: NoAction)
  requirement CredentialRequirement @relation(fields: [credentialRequirementId], references: [id], onDelete: Restrict, map: "student_credentials_credential_requirement_id_foreign", onUpdate: NoAction)
  submitter   User?                 @relation("CredentialSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull, map: "student_credentials_submitted_by_foreign", onUpdate: NoAction)
  verifier    User?                 @relation("CredentialVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull, map: "student_credentials_verified_by_foreign", onUpdate: NoAction)

  @@unique([studentId, credentialRequirementId], map: "student_credentials_student_id_credential_requirement_id_unique")
  @@map("student_credentials")
}

model Enrollment {
  id           BigInt    @id @default(autoincrement())
  studentId    BigInt    @map("student_id")
  curriculumId BigInt    @map("curriculum_id")
  schoolYear   String    @map("school_year") @db.VarChar(255)
  /// The school year as a record. The `school_year` string stays — every
  /// existing screen reads it — and this is backfilled from it.
  schoolYearId BigInt?   @map("school_year_id")
  semester     Int       @db.SmallInt
  yearLevel    Int       @map("year_level") @db.SmallInt
  status       String    @default("pending") @db.VarChar(255)
  approvedBy   BigInt?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamp(0)
  createdAt    DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  student       Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict, map: "enrollments_student_id_foreign", onUpdate: NoAction)
  curriculum    Curriculum                @relation(fields: [curriculumId], references: [id], onDelete: Restrict, map: "enrollments_curriculum_id_foreign", onUpdate: NoAction)
  approver      User?                     @relation("EnrollmentApprover", fields: [approvedBy], references: [id], onDelete: SetNull, map: "enrollments_approved_by_foreign", onUpdate: NoAction)
  statusHistory EnrollmentStatusHistory[]
  schoolYearRef SchoolYear?               @relation(fields: [schoolYearId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([studentId, schoolYear, semester], map: "enrollments_student_id_school_year_semester_unique")
  @@map("enrollments")
}

model EnrollmentStatusHistory {
  id           BigInt   @id @default(autoincrement())
  enrollmentId BigInt   @map("enrollment_id")
  fromStatus   String?  @map("from_status") @db.VarChar(255)
  toStatus     String   @map("to_status") @db.VarChar(255)
  changedBy    BigInt?  @map("changed_by")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, map: "enrollment_status_history_enrollment_id_foreign", onUpdate: NoAction)
  actor      User?      @relation("EnrollmentStatusActor", fields: [changedBy], references: [id], onDelete: SetNull, map: "enrollment_status_history_changed_by_foreign", onUpdate: NoAction)

  @@map("enrollment_status_history")
}

// ---------------------------------------------------------------------------
// Diploma Instructor module
// ---------------------------------------------------------------------------
//
// Every teaching record belongs to a school year, directly or through its
// class, so an archived year can be kept read-only and a new one starts clean
// without duplicating anybody: students stay permanent records, and a school
// year owns only the sections, classes and results made within it.
//
// "Who did it" columns (recorded_by, entered_by, created_by, …) are plain user
// ids without a foreign key: deleting an account must never cascade into
// academic records, and nothing joins through them.

/// UPCOMING | ACTIVE | ARCHIVED. At most one ACTIVE — enforced by a partial
/// unique index in the migration, which Prisma's schema language cannot
/// express. An ARCHIVED year is read-only in every service that writes.
model SchoolYear {
  id              BigInt    @id @default(autoincrement())
  label           String    @unique(map: "school_years_label_unique") @db.VarChar(20)
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime  @map("ends_on") @db.Date
  status          String    @default("UPCOMING") @db.VarChar(16)
  currentSemester Int       @default(1) @map("current_semester") @db.SmallInt
  archivedAt      DateTime? @map("archived_at")
  archivedBy      BigInt?   @map("archived_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  enrollments    Enrollment[]
  sections       Section[]
  classes        ClassOffering[]
  calendarEvents CalendarEvent[]

  @@index([status])
  @@map("school_years")
}

/// A group of students in one program and year level, for one school year.
model Section {
  id           BigInt   @id @default(autoincrement())
  schoolYearId BigInt   @map("school_year_id")
  programId    BigInt   @map("program_id")
  yearLevel    Int      @map("year_level") @db.SmallInt
  name         String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  schoolYear SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  program    Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  students   SectionStudent[]
  classes    ClassOffering[]

  @@unique([schoolYearId, programId, yearLevel, name], map: "sections_unique")
  @@map("sections")
}

/// Section membership. One section per student per school year.
model SectionStudent {
  id           BigInt   @id @default(autoincrement())
  sectionId    BigInt   @map("section_id")
  studentId    BigInt   @map("student_id")
  schoolYearId BigInt   @map("school_year_id")
  createdAt    DateTime @default(now()) @map("created_at")

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, studentId], map: "section_students_one_per_year")
  @@index([sectionId])
  @@map("section_students")
}

/// A subject taught to a section in one semester, by one Diploma Instructor.
/// The instructor assignment is what every Instructor permission hangs off.
model ClassOffering {
  id                BigInt    @id @default(autoincrement())
  schoolYearId      BigInt    @map("school_year_id")
  semester          Int       @db.SmallInt
  sectionId         BigInt    @map("section_id")
  subjectId         BigInt    @map("subject_id")
  instructorId      BigInt?   @map("instructor_id")
  room              String?   @db.VarChar(50)
  passingGrade      Decimal   @default(75) @map("passing_grade") @db.Decimal(5, 2)
  /// Category weights for the final grade, in percent: QUIZ, EXAM, ACTIVITY, PT.
  weights           Json      @default("{\"QUIZ\":20,\"EXAM\":40,\"ACTIVITY\":20,\"PT\":20}")
  /// DRAFT | FINALIZED | RELEASED — students see grades only once RELEASED.
  gradeStatus       String    @default("DRAFT") @map("grade_status") @db.VarChar(16)
  gradesFinalizedAt DateTime? @map("grades_finalized_at")
  gradesReleasedAt  DateTime? @map("grades_released_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  schoolYear         SchoolYear             @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  section            Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject            Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  instructor         User?                  @relation("ClassInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  schedules          ClassSchedule[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  grades             ClassGrade[]
  documents          AcademicDocument[]
  badges             StudentBadge[]
  learningSupports   LearningSupport[]
  statusRequests     StudentStatusRequest[]

  @@unique([sectionId, subjectId, semester], map: "classes_unique")
  @@index([instructorId])
  @@index([schoolYearId])
  @@map("classes")
}

/// A weekly meeting. Times are institution-local "HH:MM"; day 0 = Sunday.
model ClassSchedule {
  id        BigInt  @id @default(autoincrement())
  classId   BigInt  @map("class_id")
  dayOfWeek Int     @map("day_of_week") @db.SmallInt
  startTime String  @map("start_time") @db.VarChar(5)
  endTime   String  @map("end_time") @db.VarChar(5)
  room      String? @db.VarChar(50)

  class ClassOffering @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_schedules")
}

/// In-app notifications, shown behind the header bell.
model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  body      String?
  href      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// One class meeting's attendance. OPEN while scanning; CLOSED marks the rest absent.
model AttendanceSession {
  id               BigInt    @id @default(autoincrement())
  classId          BigInt    @map("class_id")
  meetingDate      DateTime  @map("meeting_date") @db.Date
  startTime        String    @map("start_time") @db.VarChar(5)
  endTime          String    @map("end_time") @db.VarChar(5)
  lateAfterMinutes Int       @default(15) @map("late_after_minutes") @db.SmallInt
  status           String    @default("OPEN") @db.VarChar(16)
  openedBy         BigInt?   @map("opened_by")
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")

  class   ClassOffering      @relation(fields: [classId], references: [id], onDelete: Restrict)
  records AttendanceRecord[]

  @@unique([classId, meetingDate, startTime], map: "attendance_sessions_unique")
  @@map("attendance_sessions")
}

/// PRESENT | LATE | ABSENT | EXCUSED. One per student per session — the
/// unique index is what makes a second scan a time-out, never a duplicate.
model AttendanceRecord {
  id         BigInt    @id @default(autoincrement())
  sessionId  BigInt    @map("session_id")
  studentId  BigInt    @map("student_id")
  status     String    @db.VarChar(16)
  timeIn     DateTime? @map("time_in")
  timeOut    DateTime? @map("time_out")
  method     String    @default("QR") @db.VarChar(16)
  recordedBy BigInt?   @map("recorded_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId], map: "attendance_records_unique")
  @@map("attendance_records")
}

/// Quizzes, examinations, online activities and performance tasks.
/// `published` makes a scheduled assessment visible to students; results
/// follow `scoreStatus`: DRAFT → FINALIZED → RELEASED.
model Assessment {
  id              BigInt    @id @default(autoincrement())
  classId         BigInt    @map("class_id")
  kind            String    @db.VarChar(16)
  examType        String?   @map("exam_type") @db.VarChar(16)
  title           String    @db.VarChar(255)
  description     String?
  instructions    String?
  opensAt         DateTime? @map("opens_at")
  closesAt        DateTime? @map("closes_at")
  durationMinutes Int?      @map("duration_minutes")
  totalItems      Int       @default(0) @map("total_items")
  totalPoints     Decimal   @map("total_points") @db.Decimal(7, 2)
  passingScore    Decimal?  @map("passing_score") @db.Decimal(7, 2)
  published       Boolean   @default(false)
  onlineEnabled   Boolean   @default(false) @map("online_enabled")
  scoreStatus     String    @default("DRAFT") @map("score_status") @db.VarChar(16)
  releasedAt      DateTime? @map("released_at")
  createdBy       BigInt?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  class  ClassOffering     @relation(fields: [classId], references: [id], onDelete: Restrict)
  items  AssessmentItem[]
  scores AssessmentScore[]

  @@index([classId])
  @@map("assessments")
}

/// One question and its key. `answer` is never sent to a student before release.
model AssessmentItem {
  id           BigInt  @id @default(autoincrement())
  assessmentId BigInt  @map("assessment_id")
  number       Int
  prompt       String?
  choices      Json?
  answer       String  @db.VarChar(255)
  points       Decimal @default(1) @db.Decimal(6, 2)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, number], map: "assessment_items_unique")
  @@map("assessment_items")
}

/// A student's result on an assessment: ONLINE, SHEET (checked against the
/// key) or MANUAL. One per student per assessment. `points` is null while an
/// online attempt is in progress.
model AssessmentScore {
  id           BigInt    @id @default(autoincrement())
  assessmentId BigInt    @map("assessment_id")
  studentId    BigInt    @map("student_id")
  points       Decimal?  @db.Decimal(7, 2)
  answers      Json?
  source       String    @db.VarChar(16)
  startedAt    DateTime? @map("started_at")
  submittedAt  DateTime? @map("submitted_at")
  enteredBy    BigInt?   @map("entered_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId], map: "assessment_scores_unique")
  @@map("assessment_scores")
}

/// A student's grade in a class: computed on finalize, visible when released.
model ClassGrade {
  id        BigInt   @id @default(autoincrement())
  classId   BigInt   @map("class_id")
  studentId BigInt   @map("student_id")
  percent   Decimal? @db.Decimal(6, 2)
  remarks   String?  @db.VarChar(32)
  note      String?
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  class   ClassOffering @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId], map: "class_grades_unique")
  @@map("class_grades")
}

/// The school calendar. Managed centrally; Instructors and Students view it.
model CalendarEvent {
  id           BigInt   @id @default(autoincrement())
  schoolYearId BigInt?  @map("school_year_id")
  title        String   @db.VarChar(255)
  description  String?
  type         String   @db.VarChar(24)
  startsOn     DateTime @map("starts_on") @db.Date
  endsOn       DateTime @map("ends_on") @db.Date
  createdBy    BigInt?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@index([startsOn])
  @@map("calendar_events")
}

model StudentBadge {
  id        BigInt   @id @default(autoincrement())
  studentId BigInt   @map("student_id")
  classId   BigInt?  @map("class_id")
  badge     String   @db.VarChar(32)
  reason    String   @db.VarChar(255)
  message   String?
  awardedOn DateTime @map("awarded_on") @db.Date
  awardedBy BigInt?  @map("awarded_by")
  createdAt DateTime @default(now()) @map("created_at")

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   ClassOffering? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_badges")
}

/// Lesson plans, Tables of Specifications and Performance Task documentation.
/// DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED | RETURNED. The file lives in
/// Vercel Blob; `file_key` is its pathname, never handed to the browser.
model AcademicDocument {
  id           BigInt    @id @default(autoincrement())
  kind         String    @db.VarChar(16)
  classId      BigInt    @map("class_id")
  title        String    @db.VarChar(255)
  documentDate DateTime? @map("document_date") @db.Date
  details      Json?
  fileKey      String?   @map("file_key") @db.VarChar(512)
  fileName     String?   @map("file_name") @db.VarChar(255)
  fileType     String?   @map("file_type") @db.VarChar(128)
  fileSize     Int?      @map("file_size")
  status       String    @default("DRAFT") @db.VarChar(16)
  reviewNote   String?   @map("review_note")
  reviewedBy   BigInt?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  submittedAt  DateTime? @map("submitted_at")
  createdBy    BigInt?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  class ClassOffering @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@index([classId])
  @@index([kind, status])
  @@map("academic_documents")
}

/// An Instructor's request to change a student's status. Nothing changes on
/// the student until a Director, Coordinator or Secretary approves it.
model StudentStatusRequest {
  id              BigInt    @id @default(autoincrement())
  studentId       BigInt    @map("student_id")
  classId         BigInt?   @map("class_id")
  currentStatus   String    @map("current_status") @db.VarChar(32)
  requestedStatus String    @map("requested_status") @db.VarChar(32)
  reason          String
  status          String    @default("PENDING") @db.VarChar(16)
  requestedBy     BigInt?   @map("requested_by")
  decidedBy       BigInt?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  decisionNote    String?   @map("decision_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   ClassOffering? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("student_status_requests")
}

/// A Learning Support Recommendation — never a label shown to the student.
model LearningSupport {
  id            BigInt    @id @default(autoincrement())
  studentId     BigInt    @map("student_id")
  classId       BigInt    @map("class_id")
  difficulty    String
  evidence      String?
  interventions Json      @default("[]")
  support       String?
  followUpOn    DateTime? @map("follow_up_on") @db.Date
  notes         String?
  status        String    @default("OPEN") @db.VarChar(16)
  createdBy     BigInt?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   ClassOffering @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("learning_supports")
}

/// The Instructor's Personal Data Sheet, one section per JSON column.
model InstructorProfile {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique(map: "instructor_profiles_user_unique") @map("user_id")
  employeeId  String?  @map("employee_id") @db.VarChar(64)
  personal    Json     @default("{}")
  family      Json     @default("{}")
  education   Json     @default("[]")
  eligibility Json     @default("[]")
  work        Json     @default("[]")
  training    Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instructor_profiles")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  action    String   @db.VarChar(255)
  actor     String   @db.VarChar(255)
  target    String   @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  details   Json?    @db.Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Status values
// ---------------------------------------------------------------------------
//
// Deliberately NOT Prisma enums. Laravel's $table->enum() on PostgreSQL
// produces varchar(255) plus a CHECK constraint, and this database contains
// no native enum types at all (verified against pg_type). Declaring Prisma
// enums here would make Prisma want to CREATE TYPE and rewrite five live
// columns — a destructive migration for zero gain.
//
// The CHECK constraints remain the authority in the database; the matching
// TypeScript unions and Zod schemas live in src/types/domain.ts, so invalid
// values are rejected before a query is ever built.

// ---------------------------------------------------------------------------
// Legacy Laravel infrastructure — retained, unused, never dropped implicitly
// ---------------------------------------------------------------------------

/// Old Laravel session store. Its `payload` is a PHP-serialised blob that
/// Node cannot read, which is why auth_sessions exists instead. Kept so no
/// migration deletes it behind your back.
model LegacySession {
  id           String  @id @db.VarChar(255)
  userId       BigInt? @map("user_id")
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  userAgent    String? @map("user_agent")
  payload      String
  lastActivity Int     @map("last_activity")

  @@index([userId], map: "sessions_user_id_index")
  @@index([lastActivity], map: "sessions_last_activity_index")
  @@map("sessions")
}

model LegacyMigration {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int

  @@map("migrations")
}

model LegacyCache {
  key        String @id @db.VarChar(255)
  value      String
  expiration BigInt

  @@index([expiration], map: "cache_expiration_index")
  @@map("cache")
}

model LegacyCacheLock {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration BigInt

  @@index([expiration], map: "cache_locks_expiration_index")
  @@map("cache_locks")
}

model LegacyJob {
  id          BigInt @id @default(autoincrement())
  queue       String @db.VarChar(255)
  payload     String
  attempts    Int    @db.SmallInt
  reservedAt  Int?   @map("reserved_at")
  availableAt Int    @map("available_at")
  createdAt   Int    @map("created_at")

  @@index([queue], map: "jobs_queue_index")
  @@map("jobs")
}

model LegacyJobBatch {
  id           String  @id @db.VarChar(255)
  name         String  @db.VarChar(255)
  totalJobs    Int     @map("total_jobs")
  pendingJobs  Int     @map("pending_jobs")
  failedJobs   Int     @map("failed_jobs")
  failedJobIds String  @map("failed_job_ids")
  options      String?
  cancelledAt  Int?    @map("cancelled_at")
  createdAt    Int     @map("created_at")
  finishedAt   Int?    @map("finished_at")

  @@map("job_batches")
}

model LegacyFailedJob {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.VarChar(255)
  queue      String   @db.VarChar(255)
  payload    String
  exception  String
  failedAt   DateTime @default(now()) @map("failed_at") @db.Timestamp(0)

  @@index([connection, queue, failedAt], map: "failed_jobs_connection_queue_failed_at_index")
  @@map("failed_jobs")
}
