{
  // Shared compiler options. The projects are server/tsconfig.json and
  // client/tsconfig.json; this file compiles nothing on its own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [],
  "references": [
    { "path": "./client" },
    { "path": "./server" }
  ]
}
