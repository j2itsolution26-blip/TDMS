# ---------------------------------------------------------------------------
# TDMS — environment
# ---------------------------------------------------------------------------

# PostgreSQL. Use the POOLED host on serverless, or connections run out.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# development | production
# Drives the `secure` flag on the session cookie. Leave as development for
# local HTTP work: forcing secure cookies over http://localhost makes the
# browser drop the cookie and sign-in appears to silently fail.
NODE_ENV=development

# Session lifetime in minutes (Laravel's SESSION_LIFETIME was 120).
SESSION_LIFETIME_MINUTES=120

# bcrypt cost. Keep at 12: it matches every hash the Laravel app wrote,
# so existing passwords keep working without a reset.
BCRYPT_ROUNDS=12

# Password given to the accounts created by `npm run db:seed:demo`.
# Development only — never set this in the Vercel project.
DEMO_SEED_PASSWORD=Password123!
