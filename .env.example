# ---------------------------------------------------------------------------
# TDMS — environment
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Use the POOLED host on serverless, or connections run out.
# If only Laravel's DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD/
# DB_SSLMODE are set, the runtime composes this from them — see
# docs/deployment.md. The Prisma CLI always needs DATABASE_URL.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# development | production
# Drives the `secure` flag on the session cookie. Leave as development for
# local HTTP work: forcing secure cookies over http://localhost makes the
# browser drop the cookie and sign-in appears to silently fail.
NODE_ENV=development

# --- Email domain policy ---------------------------------------------------
# Whether TDMS restricts accounts to one email domain.
#
# OFF (the default, and the current development setting): any well-formed,
# Google-verified address is accepted — gmail.com included. Malformed
# addresses are still rejected; that is a separate check.
#
# ON: only the domain below is accepted, matched EXACTLY, with lookalikes
# such as notasiancollege.edu.ph and asiancollege.edu.ph.evil.com rejected.
#
# Turn it on for launch:
#   GOOGLE_DOMAIN_RESTRICTION_ENABLED=true
#   GOOGLE_ALLOWED_DOMAIN=asiancollege.edu.ph
#
# Only an explicit true/1/yes/on enables it, so a typo leaves it off rather
# than half-on. Check which way a deployment is set with /api/health.
GOOGLE_DOMAIN_RESTRICTION_ENABLED=false
GOOGLE_ALLOWED_DOMAIN=asiancollege.edu.ph

# Development convenience: make a first-time Google sign-in ACTIVE instead of
# PENDING, so you can walk the flow without a second person to approve you.
# Grants NO role — activation and authorization are different things, and a
# variable that handed out roles would be one typo from a privilege
# escalation. Assign roles from the Staff screen.
DEV_AUTO_ACTIVATE_GOOGLE_USERS=false

# Absolute base URL used to build links in outgoing email. Never derived from
# a request header: Host is attacker-controlled, and a poisoned value would
# send verification links to somebody else's domain.
APP_URL=http://localhost:3000

# --- First-run setup -------------------------------------------------------
# A new installation has no accounts. The first Super Admin is created at
# /setup, which asks for this key: only someone who can set server
# environment variables can claim the system. At least 16 characters; make it
# random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Not needed once setup is done (you may remove it then). Without it, /setup
# stays locked; `npm run admin:create` works without it.
SETUP_KEY=

# --- Email delivery --------------------------------------------------------
# Required for Admin access codes, invitations, verification and password
# resets. There is no silent fallback: if nothing below is configured, sending
# FAILS and the flows that need it refuse to proceed.

# Which provider to use. Leave unset to derive it from what is configured,
# which prefers Resend.
#
#   resend       the HTTP API. This is the production setting.
#   smtp         MAIL_HOST/MAIL_PORT below, even if a Resend key is present.
#   development  write the code to the server log instead of sending it.
#                Refused when NODE_ENV=production.
EMAIL_PROVIDER=resend

# --- Resend (the transport) ------------------------------------------------
# Server-side only. Not prefixed NEXT_PUBLIC_, so it never reaches the browser,
# and it is read only inside `server-only` modules. Get one from
# https://resend.com/api-keys — never commit a real key.
RESEND_API_KEY=

# The From header, complete.
#
# DEVELOPMENT: onboarding@resend.dev is Resend's shared test sender and needs
# no domain verification. Its limitation is the recipient, not the sender: an
# account with no verified domain may only deliver to the address that OWNS the
# Resend account. Emailing anybody else returns 403, which this application
# reports as EMAIL_RECIPIENT_NOT_ALLOWED.
#
# PRODUCTION: verify a domain at https://resend.com/domains and use an address
# on it, e.g. "TDMS <no-reply@yourdomain.com>". Until then, only your own
# address receives anything.
EMAIL_FROM="TDMS <onboarding@resend.dev>"

# --- SMTP (only with EMAIL_PROVIDER=smtp, or when no Resend key is set) -----
# For an institutional mail server, or a local mail catcher in development.
# MAIL_ENCRYPTION is optional: left empty, TLS is derived from the port
# (implicit TLS on 465, STARTTLS elsewhere). STARTTLS is required, not merely
# attempted, so credentials are never sent over a plain connection.
#
# NEVER set MAIL_HOST to 127.0.0.1 or localhost in a deployed environment. On a
# serverless function that is the function's own sandbox, where nothing is
# listening. A loopback host is ignored when a Resend key is present, and
# reported as a configuration fault when it is not.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# Superseded by EMAIL_FROM, still read so an older deployment keeps its sender.
# MAIL_FROM_ADDRESS=no-reply@asiancollege.edu.ph
# MAIL_FROM_NAME=TDMS

# Check what a target has actually resolved, without sending anything:
#   npm run mail:check -- --base https://your-app.vercel.app

# --- Google sign-in --------------------------------------------------------
# All three are required together. If any is missing, Google sign-in is
# treated as unconfigured: the button is not rendered and the route redirects
# back with an error rather than half-working.
#
# The redirect URI must match a value registered on the OAuth client EXACTLY,
# including scheme, host, port and path. See docs/google-auth.md.
#
# None of these is NEXT_PUBLIC_, so none reaches the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Development email mode ------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Writes the verification code to the server log
# instead of sending it, so the registration flow can be walked before a mail
# provider exists.
#
# Two conditions, both required, and the second is not overridable:
#   1. this is set to exactly "development" — an explicit opt-in, never
#      inferred from the absence of a provider;
#   2. NODE_ENV is not "production". A verification code in a production log
#      is a credential somewhere far more people can read than the mailbox it
#      was meant for. Asked for in production, it is refused and logged.
#
# Leave BLANK unless you are developing locally.
EMAIL_VERIFICATION_MODE=

# --- Sessions and tokens ---------------------------------------------------
SESSION_LIFETIME_MINUTES=120
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- One-time code limits --------------------------------------------------
# Limits for emailed six-digit codes. Short-lived and capped in both
# directions: guesses against one code, and codes sent per attempt.
# The defaults are the shipped values; override only with reason.
SUPER_ADMIN_CODE_TTL_MINUTES=10
SUPER_ADMIN_CODE_MAX_ATTEMPTS=5
SUPER_ADMIN_CODE_MAX_RESENDS=3
SUPER_ADMIN_CODE_RESEND_COOLDOWN_SECONDS=60
# How long after verification the operator has to finish creating the account.
SUPER_ADMIN_COMPLETION_WINDOW_MINUTES=30

# Passwords are hashed with Argon2id (fixed parameters, in code). Legacy
# bcrypt hashes from Laravel still verify and are upgraded to Argon2id on the
# owner's next sign-in, so no reset is needed.
#
# This bcrypt cost now applies only to the short-lived one-time codes (Admin
# access codes and email verification codes).
BCRYPT_ROUNDS=12

# --- Super Admin security code ---------------------------------------------
# A root-level secret held by the system owner. It is NOT an Admin login code,
# and it is NOT asked for when creating Admins, issuing or revoking access codes,
# or resetting passwords — the signed-in Super Admin Dashboard is the trust
# boundary for those. The dashboard shows only whether it is configured.
#
# No value is shipped and there is no default. Supply your own, e.g.
# `openssl rand -base64 24`, and keep it in a password manager.
#
#   * server-side only. NEVER prefix it NEXT_PUBLIC_ — that puts it in the
#     browser bundle.
#   * never committed with a real value, never stored in the database, never
#     returned by an API, never logged, never put in an audit record.
#
# On Vercel: Settings -> Environment Variables -> Add SUPER_ADMIN_STATIC_CODE,
# tick the environments, then redeploy. /api/health reports configured: true.
SUPER_ADMIN_STATIC_CODE=

# --- Temporary password reveal ---------------------------------------------
# Lets the Super Admin show an Admin's TEMPORARY password again (Credentials ->
# Show) until the Admin chooses their own.
#
# The login still checks only a bcrypt hash. Revealing needs a separate,
# encrypted copy (AES-256-GCM) in the temporary_credentials table, and this is
# its key. The key is never stored in the database, so a database dump alone
# reveals nothing; the copy is destroyed as soon as the Admin changes the
# password, it is reset, or the reveal window below passes. A permanent
# password is never stored recoverably.
#
# Exactly 32 random bytes, base64:  openssl rand -base64 32
# Server-side only; never NEXT_PUBLIC_. Without it, temporary passwords are
# shown once when issued and cannot be shown again. Rotating it makes
# outstanding temporary passwords unrevealable (reset to issue new ones).
TEMP_CREDENTIAL_KEY=
# How long a temporary password stays revealable, in hours (max 720).
TEMP_CREDENTIAL_REVEAL_HOURS=72

# --- Administrator access codes --------------------------------------------
# The six-digit one-time code a Super Admin issues from the dashboard's Admin
# Access Codes page for one Admin, which that Admin types after their password.
# EXPIRATION_MINUTES is the default offered in the Generate dialog; the Super
# Admin may pick 5-60 minutes per code, and no code ever lasts over an hour. Generated with a CSPRNG and
# stored only as a bcrypt hash.
#
# At six digits the ATTEMPT CAP, not the length, is what protects the code:
# 5 guesses against a million candidates is the security. Raising
# ADMIN_ACCESS_CODE_MAX_ATTEMPTS much above the default gives that away.
ADMIN_ACCESS_CODE_EXPIRATION_MINUTES=10
ADMIN_ACCESS_CODE_MAX_ATTEMPTS=5

# How long a half-finished Admin sign-in survives — the window between a
# correct password and a correct code. Longer than one code's life on purpose,
# so waiting for a Super Admin to issue a replacement does not throw the person
# back to the password screen. No session exists during this window.
ADMIN_LOGIN_CHALLENGE_TTL_MINUTES=15
