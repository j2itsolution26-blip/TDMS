# ---------------------------------------------------------------------------
# TDMS — environment
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Use the POOLED host on serverless, or connections run out.
# If only Laravel's DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD/
# DB_SSLMODE are set, the runtime composes this from them — see
# docs/deployment.md. The Prisma CLI always needs DATABASE_URL.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# development | production
# Drives the `secure` flag on the session cookie. Leave as development for
# local HTTP work: forcing secure cookies over http://localhost makes the
# browser drop the cookie and sign-in appears to silently fail.
NODE_ENV=development

# --- Email domain policy ---------------------------------------------------
# Whether TDMS restricts accounts to one email domain.
#
# OFF (the default, and the current development setting): any well-formed,
# Google-verified address is accepted — gmail.com included. Malformed
# addresses are still rejected; that is a separate check.
#
# ON: only the domain below is accepted, matched EXACTLY, with lookalikes
# such as notasiancollege.edu.ph and asiancollege.edu.ph.evil.com rejected.
#
# Turn it on for launch:
#   GOOGLE_DOMAIN_RESTRICTION_ENABLED=true
#   GOOGLE_ALLOWED_DOMAIN=asiancollege.edu.ph
#
# Only an explicit true/1/yes/on enables it, so a typo leaves it off rather
# than half-on. Check which way a deployment is set with /api/health.
GOOGLE_DOMAIN_RESTRICTION_ENABLED=false
GOOGLE_ALLOWED_DOMAIN=asiancollege.edu.ph

# Development convenience: make a first-time Google sign-in ACTIVE instead of
# PENDING, so you can walk the flow without a second person to approve you.
# Grants NO role — activation and authorization are different things, and a
# variable that handed out roles would be one typo from a privilege
# escalation. Assign roles from the Staff screen.
DEV_AUTO_ACTIVATE_GOOGLE_USERS=false

# Absolute base URL used to build links in outgoing email. Never derived from
# a request header: Host is attacker-controlled, and a poisoned value would
# send verification links to somebody else's domain.
APP_URL=http://localhost:3000

# --- Email delivery --------------------------------------------------------
# Required for the Super Admin setup code, invitations, verification and
# password resets. There is no silent fallback: if nothing below is configured,
# sending FAILS and the flows that need it refuse to proceed. No Super Admin
# account is ever created when the verification code cannot be delivered.

# Which provider to use. Leave unset to derive it from what is configured,
# which prefers Resend.
#
#   resend       the HTTP API. This is the production setting.
#   smtp         MAIL_HOST/MAIL_PORT below, even if a Resend key is present.
#   development  write the code to the server log instead of sending it.
#                Refused when NODE_ENV=production.
EMAIL_PROVIDER=resend

# --- Resend (the production transport) -------------------------------------
# Server-side only. Not prefixed NEXT_PUBLIC_, so it never reaches the browser.
RESEND_API_KEY=

# The From header, complete. The domain must be VERIFIED with Resend, or every
# send is refused with a 403 — an unverified account may only write to the
# address that owns it.
EMAIL_FROM="TDMS <no-reply@yourdomain.com>"

# --- SMTP (only with EMAIL_PROVIDER=smtp, or when no Resend key is set) -----
# For an institutional mail server, or a local mail catcher in development.
# MAIL_ENCRYPTION is optional: left empty, TLS is derived from the port
# (implicit TLS on 465, STARTTLS elsewhere). STARTTLS is required, not merely
# attempted, so credentials are never sent over a plain connection.
#
# NEVER set MAIL_HOST to 127.0.0.1 or localhost in a deployed environment. On a
# serverless function that is the function's own sandbox, where nothing is
# listening. A loopback host is ignored when a Resend key is present, and
# reported as a configuration fault when it is not.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# Superseded by EMAIL_FROM, still read so an older deployment keeps its sender.
# MAIL_FROM_ADDRESS=no-reply@asiancollege.edu.ph
# MAIL_FROM_NAME=TDMS

# Check what a target has actually resolved, without sending anything:
#   npm run mail:check -- --base https://your-app.vercel.app

# --- Google sign-in --------------------------------------------------------
# All three are required together. If any is missing, Google sign-in is
# treated as unconfigured: the button is not rendered and the route redirects
# back with an error rather than half-working.
#
# The redirect URI must match a value registered on the OAuth client EXACTLY,
# including scheme, host, port and path. See docs/google-auth.md.
#
# None of these is NEXT_PUBLIC_, so none reaches the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Development email mode ------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Writes the verification code to the server log
# instead of sending it, so the registration flow can be walked before a mail
# provider exists.
#
# Two conditions, both required, and the second is not overridable:
#   1. this is set to exactly "development" — an explicit opt-in, never
#      inferred from the absence of a provider;
#   2. NODE_ENV is not "production". A verification code in a production log
#      is a credential somewhere far more people can read than the mailbox it
#      was meant for. Asked for in production, it is refused and logged.
#
# Leave BLANK unless you are developing locally.
EMAIL_VERIFICATION_MODE=

# --- Sessions and tokens ---------------------------------------------------
SESSION_LIFETIME_MINUTES=120
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Super Admin setup code ------------------------------------------------
# The six-digit code emailed during first-time setup. Short-lived and capped
# in both directions: guesses against one code, and codes sent per attempt.
# The defaults are the shipped values; override only with reason.
SUPER_ADMIN_CODE_TTL_MINUTES=10
SUPER_ADMIN_CODE_MAX_ATTEMPTS=5
SUPER_ADMIN_CODE_MAX_RESENDS=3
SUPER_ADMIN_CODE_RESEND_COOLDOWN_SECONDS=60
# How long after verification the operator has to finish creating the account.
SUPER_ADMIN_COMPLETION_WINDOW_MINUTES=30

# bcrypt cost. Keep at 12: it matches every hash written so far, so existing
# passwords keep working without a reset.
BCRYPT_ROUNDS=12
